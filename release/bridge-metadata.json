{
  "claude-code": {
    "displayName": "Claude Code",
    "acpProtocol": { "min": 1, "max": 1 },
    "command": ["claude-agent-acp"],
    "tooling": { "login": ["claude", "auth", "login"], "logout": ["claude", "auth", "logout"], "identitySignal": ["claude", "auth", "status", "--json"] },
    "egress": { "baseUrlEnv": "ANTHROPIC_BASE_URL", "providers": ["anthropic"] }
  },
  "codex": {
    "displayName": "Codex",
    "acpProtocol": { "min": 1, "max": 1 },
    "command": ["codex-acp"],
    "tooling": {
      "login": ["codex", "login", "--device-auth"],
      "logout": ["codex", "logout"],
      "identitySignal": ["codex", "login", "status"],
      "hostCacheImport": { "relativePath": ".codex/auth.json", "documentedBy": "https://github.com/openai/codex/blob/main/docs/authentication.md" }
    },
    "egress": { "baseUrlEnv": "OPENAI_BASE_URL", "providers": ["openai"] }
  }
}
