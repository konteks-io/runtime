{
  "name": "@konteks/remote-sysmon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read-only host utilization signals for heartbeat and D74 ranking.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --build --noEmit",
    "test": "vitest run --root ../.. --project unit -- packages/sysmon"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@konteks/remote-common": "*",
    "zod": "^4.0.0"
  }
}
