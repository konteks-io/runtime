{
  "name": "@konteks/remote-agent-runner",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "Agent runner: spawns one pinned ACP bridge family over stdio in a private credential volume, drives official login/logout, publishes sanitized readiness, serves ACP sessions to the supervisor.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --build --noEmit",
    "test": "vitest run --root ../.. --project unit -- packages/agent-runner"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@konteks/backstage-plugin-common": "file:../../../packages/packages/backstage-plugin-common",
    "@konteks/remote-common": "*",
    "@konteks/remote-release": "*",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-fs": "0.1.5-rc.3",
    "@deepseek-ai/dsh-fs-sandbox": "0.1.5-rc.3",
    "@types/ws": "^8.18.1"
  }
}
