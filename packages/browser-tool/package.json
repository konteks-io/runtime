{
  "name": "@konteks/remote-browser-tool",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "Headless Chromium/Playwright exposed as an MCP tool to qa-role agents; no provider access.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --build --noEmit",
    "test": "vitest run --root ../.. --project unit -- packages/browser-tool"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@konteks/remote-common": "*",
    "@modelcontextprotocol/sdk": "^1.20.0",
    "playwright-core": "^1.52.0",
    "zod": "^4.0.0"
  }
}
