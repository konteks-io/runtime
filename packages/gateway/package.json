{
  "name": "@konteks/remote-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Runtime-local egress gateway: per-dialect provider egress, in-memory key stamping, signed allowlist, three-stage cap enforcement, GatewayCallObservation.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --build --noEmit",
    "test": "vitest run --root ../.. --project unit -- packages/gateway"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@konteks/backstage-plugin-common": "file:../../vendor/konteks-backstage-plugin-common-6.0.0.tgz",
    "@konteks/remote-common": "*",
    "pino": "^9.5.0",
    "zod": "^4.0.0"
  }
}
