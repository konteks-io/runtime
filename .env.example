# Konteks Remote Instance — developer environment (never used by the customer bundle).
#
# The customer-facing appliance is configured by `konteks-remote install`,
# which renders its own `.env` for Compose from the SIGNED release manifest.
# Nothing in this file is ever read by that path. These variables only affect
# local development of the launcher/supervisor and the release tooling.

# Launcher defaults (override the embedded production endpoints while developing).
KONTEKS_CORE_URL=https://core.konteks.example
KONTEKS_RELAY_URL=wss://relay.konteks.example/relay/runtime
KONTEKS_RELEASE_MANIFEST_URL=https://releases.konteks.example/remote-instance/stable/release-manifest.json
# Restricted install root used by a developer launcher build (defaults per OS otherwise).
KONTEKS_REMOTE_ROOT=./.konteks-remote
# Loopback control port the launcher dials (must match the rendered Compose port mapping).
KONTEKS_CONTROL_PORT=41800

# Release roots embedded into a developer launcher build: `{"roots":[{"keyId":"…","publicKeyJwk":{…}}]}`.
# Generate a throwaway pair with `npm run release:manifest -- keygen --key-id dev --out dev.key.json --root-out dev.roots.json`.
# A launcher built without roots verifies nothing and therefore installs nothing (bundle_untrusted).
KONTEKS_RELEASE_ROOTS_JSON=

# Image builds resolve the shared @konteks/* contracts from the Konteks registry (scripts/pin-registry-deps.mjs).
KONTEKS_CONTRACTS_VERSION=5.11.0

# Opt-in characterization suites (need Docker Compose v2 / network access).
REMOTE_INSTANCE_CHARACTERIZE=0

# Bootstrap script pins (bootstrap/install.sh, bootstrap/install.ps1) — production values are baked in at release time.
KONTEKS_RELEASE_BASE=https://releases.konteks.example/remote-instance/stable
KONTEKS_RELEASE_PUBKEY_SHA256=
KONTEKS_MACOS_TEAM_ID=
KONTEKS_DEB_KEY_FINGERPRINT=
KONTEKS_MSI_PUBLISHER=
KONTEKS_MSI_THUMBPRINT=
