# Konteks native connector — developer environment (never read by an installed connector).
#
# These variables only affect local development of the launcher/supervisor
# and the release tooling. An installed connector takes its settings from its
# private runtime record, never from this file.

# Launcher defaults (override the embedded production endpoints while developing).
KONTEKS_CORE_URL=https://core.konteks.example
KONTEKS_RELAY_URL=wss://relay.konteks.example/relay/runtime
# Native release channel (the signed native-manifest.json).
KONTEKS_RELEASE_MANIFEST_URL=https://releases.konteks.example/native-manifest.json
# Loopback control port the launcher dials (the supervisor records its own port at install).
KONTEKS_CONTROL_PORT=41800

# Release roots embedded into a developer launcher build: `{"roots":[{"keyId":"…","publicKeyJwk":{…}}]}`.
# Generate a throwaway pair with `npm run release:manifest -- keygen --key-id dev --out dev.key.json --root-out dev.roots.json`.
# A launcher built without roots verifies nothing and therefore installs nothing (bundle_untrusted).
KONTEKS_RELEASE_ROOTS_JSON=

# Opt-in characterization suites (need installed agents or a Linux host).
REMOTE_INSTANCE_CHARACTERIZE=0

# Bootstrap script pins (bootstrap/install.sh, bootstrap/install.ps1) — production values are baked in at release time.
KONTEKS_RELEASE_BASE=https://github.com/konteks-io/runtime/releases/latest/download
KONTEKS_RELEASE_PUBKEY_SHA256=
KONTEKS_MACOS_TEAM_ID=
KONTEKS_DEB_KEY_FINGERPRINT=
KONTEKS_MSI_PUBLISHER=
KONTEKS_MSI_THUMBPRINT=
